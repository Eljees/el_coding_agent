# Default: treat as text, normalize to LF in the repo.
* text=auto eol=lf

# Keep PowerShell helpers as CRLF on disk — Windows PowerShell expects them.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Force LF for text formats that must stay LF.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf

# Known binary formats — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.tar.gz binary
*.tgz binary
*.7z binary
*.rar binary
*.gz binary
*.rpm binary
*.whl binary
*.jar binary
